            <option value="combat">Combat Encounter</option>
            <option value="view">Open Screen</option>
            <option value="dice_check">Dice Check</option>
          </select>
        </div>

        <div>
          <label style={{ fontSize: '10px' }}>TARGET PASSAGE</label>
          <select
            class="pixel-select"
