  font-family: "MinedCraft Five";
  src: url('../assets/fonts/minedcraft-five.otf') format('opentype');
  font-weight: normal;
  font-style: normal;
}

*, *::before, *::after {
  box-sizing: border-box;
}

:root {
  --pixel-bg: #212529;
